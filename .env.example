# Copia este archivo a .env y rellena tus valores
DEBUG=True
SECRET_KEY=pon-aqui-una-clave-larga-secreta
ALLOWED_HOSTS=127.0.0.1,localhost

# Intentos de login antes de bloqueo
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=30

# Email (consola por defecto: muestra el correo en la terminal)
EMAIL_BACKEND=console.EmailBackend
# Con Gmail usa: smtp.EMAILBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=tu-app-password
# DEFAULT_FROM_EMAIL=Chill Out La Bodeguita <tu-correo@gmail.com>
EMAIL_NOTIFY_TO=

# Copas por botella (regla local)
COPAS_POR_BOTELLA=8